 "faq": [
  {
   "q": "¿Qué es una indeterminación?",
   "a": "Una expresión como 0/0 o ∞/∞ cuyo valor no se conoce a primera vista; hay que transformar la función para calcular el límite."
  },
  {
   "q": "¿Cuántas asíntotas horizontales puede tener una función?",
   "a": "Como mucho dos: una en +∞ y otra en −∞. Si tiene horizontal en un lado, no tiene oblicua en ese lado."
  }
 ],
