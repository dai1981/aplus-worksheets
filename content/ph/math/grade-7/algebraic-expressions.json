  {
   "q": "Is π a variable?",
   "a": "No. It is a constant, about 3.14."
  },
  {
   "q": "What is a term?",
   "a": "A part of an expression separated by + or −."
  },
  {
   "q": "How do I write “the sum of a and b, squared”?",
   "a": "(a + b)²."
  }
