  {
   "q": "Is x² + 9 a difference of two squares?",
   "a": "No, it is a sum."
  },
  {
   "q": "How do I check?",
   "a": "Expand the brackets."
  },
  {
   "q": "What is 49 − y²?",
   "a": "(7 + y)(7 − y)."
  }
