{
 "slug": "numeri-naturali-e-operazioni",
 "title": "Numeri naturali, operazioni e proprietà",
 "seo_title": "Numeri naturali e operazioni prima media: schede di matematica con soluzioni",
 "short_title": "Numeri naturali e operazioni",
