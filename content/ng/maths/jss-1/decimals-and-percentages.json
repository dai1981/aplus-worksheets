 "domain": "Number and Numeration",
 "standard_code": "JSS 1: Number and Numeration",
 "standard_url": "https://nerdc.gov.ng/",
 "standard_text": "Convert between fractions, decimals and percentages; order fractions, decimals and percentages; find percentages of quantities. (summary of the NERDC JSS 1 Mathematics curriculum)",
 "meta_desc": "Free JSS 1 maths worksheets on converting fractions, decimals and percentages, ordering them, and finding percentages of amounts. 100 questions with answers.",
 "key_big": "Percent means per hundred",
 "key_sub": "Fraction → decimal: divide top by bottom.",
 "body_html": "<h2>How to think about it</h2><ul><li>To change a fraction to a decimal, divide the numerator by the denominator: 3/8 = 0.375.</li><li>To change a decimal to a percentage, multiply by 100: 0.375 = 37.5%.</li><li>To compare, change them all to decimals or all to percentages.</li></ul><h2>Examples</h2><div class='sn-ex'><span class='sn-ex-t'>Example</span><p class='sn-ex-q'>Order 0.6, 5/8, 58%</p><p class='sn-ex-s'>0.6, 0.625, 0.58</p><p class='sn-ex-a'>Answer: 58%, 0.6, 5/8</p></div><h2>Common mistakes</h2><div class='sn-tw'><table class='sn-table'><thead><tr><th>Mistake</th><th>What to do instead</th></tr></thead><tbody><tr><td>Writing 0.6 as 6%</td><td>0.6 = 60%.</td></tr><tr><td>Dividing the wrong way</td><td>3/8 means 3 ÷ 8.</td></tr><tr><td>Comparing digits, not values</td><td>0.58 &lt; 0.6.</td></tr></tbody></table></div>",
 "faq": [
  {
   "q": "What is 1/3 as a decimal?",
   "a": "0.333… (a recurring decimal)."
  },
  {
   "q": "What is 12.5% as a fraction?",
   "a": "1/8."
  },
  {
   "q": "Why use percentages?",
   "a": "To compare amounts out of different totals."
  }
 ],
